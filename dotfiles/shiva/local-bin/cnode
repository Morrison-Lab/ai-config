#!/usr/bin/env bash
# Interactive zsh on a shiva compute node.
#
# Two things make the obvious commands not work here, both measured on
# 2026-07-31 (Slurm 24.11.3) rather than assumed:
#
#   * `salloc` leaves the shell ON THE HEAD NODE. shiva has
#     `LaunchParameters = (null)`, so salloc's use_interactive_step is off --
#     it prints "Nodes c2 are ready for job" and then runs your shell on
#     shiva anyway. `srun --pty` is what actually moves you.
#   * shiva ships no system zsh on any node, login node included -- there is
#     no /usr/bin/zsh to fall back on. The only zsh is conda's 5.9 at
#     ~/miniconda3/bin/zsh, on shared storage, which every node can reach.
#
# That conda zsh IS on PATH, so `srun --pty zsh` resolves today; the absolute
# path below is belt-and-braces for a session whose PATH has been stripped,
# not a workaround for an unreachable binary. Earlier revisions of this
# comment claimed it was off PATH, which tui-alloc's own history disproves:
# tui-alloc resolves it with `command -v zsh` and has never hit its bash
# fallback on c2, c3, or c4, each of which has a zsh 5.9 completion dump in
# ~/.config/tui-alloc to show for it.
#
# Conda is deliberately NOT activated here. `--pty` propagates the current
# environment, so activating on the head node first carries it in; otherwise
# activate inside with the line printed on entry.
set -euo pipefail

# Shared with tui-alloc; resolve through the install symlink to find it.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/slurm-guard.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/slurm-guard.sh"

CPUS="${CNODE_CPUS:-8}"
MEM="${CNODE_MEM:-32G}"
TIME="${CNODE_TIME:-1-00:00:00}"

ZSH_BIN="${CNODE_ZSH:-$HOME/miniconda3/bin/zsh}"
if [ ! -x "$ZSH_BIN" ]; then
  echo "cnode: no usable zsh at $ZSH_BIN" >&2
  echo "       set CNODE_ZSH, or install one: conda install -n base zsh" >&2
  exit 1
fi

# Refuse to nest; lib/slurm-guard.sh records the deadlock this prevents.
refuse_if_nested "exec $ZSH_BIN -i"

echo "cnode: ${CPUS} cpu, ${MEM}, ${TIME}. Inside, for R 4.6:"
echo "    source ~/miniconda3/etc/profile.d/conda.sh && conda activate bcs"

exec srun --cpus-per-task="$CPUS" --mem="$MEM" --time="$TIME" \
     --job-name=cnode --pty "$ZSH_BIN" -i "$@"
