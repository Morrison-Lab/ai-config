{
  "description": "Run the canonical ai-config hook catalog under Codex.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/ai-config/codex-hook-adapter.py\" --event UserPromptSubmit",
            "timeout": 120,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/ai-config/codex-hook-adapter.py\" --event PreToolUse",
            "timeout": 300,
            "additionalContextLimit": 5000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/plugins/ai-config/codex-hook-adapter.py\" --event Stop",
            "timeout": 300,
            "additionalContextLimit": 5000
          }
        ]
      }
    ]
  }
}
