{
  "enforce-merge-control": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/enforce-mwc-review-gate.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      },
      {
        "matcher": "invoke_subagent|send_message|define_subagent|mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
      }
    ]
  }
}
