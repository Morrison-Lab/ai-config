#!/usr/bin/env bash
# merge-infra-pr REPO PR [--annotations-read IDS] [--dry-run]
#
# The one sanctioned path for merging an INFRA pull request without Ezra's typed word
# (Ezra, 2026-11-08: "do it"). Content PRs never go through this script.
#
# It merges only when ALL of these hold, and refuses (exit 2, nothing merged) otherwise:
#   1. the repository is Morrison-Lab/gha, Morrison-Lab/macros, Morrison-Lab/ai-config or
#      Morrison-Lab/teaching-tools (Ezra, 2026-11-10: "teaching-tools is infra"), OR every
#      file the PR changes is under .github/ or changelog.d/, or is a tools/check_*, tools/check-* or
#      tools/tests/ checker (CI, checkers, changelog). A blanket tools/ or scripts/ is not accepted:
#      a content repository can keep figure and analysis code there (see hooks/no-unauthorized-merge.py);
#   2. the PR is open, targets the default branch, and is not a draft;
#   3. scripts/check-pr-fully-clean.py exits 0 on the exact head SHA read in step 0
#      (--annotations-read passes through only after the caller has read those annotations);
#   4. the head SHA is unchanged after the checker ran.
# Then it runs one pinned merge-commit merge: --match-head-commit <full 40-char SHA>, never --admin,
# never --delete-branch, never --auto.
set -u
ORG=Morrison-Lab
AI_CONFIG_CHECKOUT=${AI_CONFIG_CHECKOUT:-/home/morri313/Documents/GitHub/ai-config}
usage() { echo "usage: merge-infra-pr REPO PR [--annotations-read IDS] [--dry-run]" >&2; exit 64; }
refuse() { echo "REFUSED: $*" >&2; exit 2; }

[ $# -ge 2 ] || usage
repo=$1; pr=$2; shift 2
case "$repo" in */*) repo=${repo##*/} ;; esac
case "$repo" in *[!A-Za-z0-9._-]*|"") refuse "bad repository name" ;; esac
case "$pr" in *[!0-9]*|"") refuse "PR must be a number" ;; esac
ann=""; dry=0
while [ $# -gt 0 ]; do
  case "$1" in
    --annotations-read) [ $# -ge 2 ] || usage; ann=$2; shift 2 ;;
    --dry-run) dry=1; shift ;;
    *) usage ;;
  esac
done
case "$ann" in *[!0-9,]*) refuse "--annotations-read takes comma-separated numeric ids" ;; esac

# 0. read the PR once, and check condition 2 (open, not a draft, base is the default branch)
info=$(gh pr view "$pr" -R "$ORG/$repo" --json state,isDraft,headRefOid,baseRefName -q '"\(.state) \(.isDraft) \(.headRefOid) \(.baseRefName)"') || refuse "cannot read $ORG/$repo#$pr"
read -r state draft head base <<<"$info"
[ "$state" = OPEN ] || refuse "PR is $state, not OPEN"
[ "$draft" = false ] || refuse "PR is a draft"
printf '%s' "$head" | grep -Eq '^[0-9a-f]{40}$' || refuse "head SHA is not 40 hex characters: $head"
default=$(gh repo view "$ORG/$repo" --json defaultBranchRef -q .defaultBranchRef.name) || refuse "cannot read default branch"
[ "$base" = "$default" ] || refuse "base is $base, not the default branch $default"

# 1. scope: infra repo, or every changed file is CI / tooling / changelog
case "$repo" in
  gha|macros|ai-config|teaching-tools) scope="infra repository $repo" ;;
  *)
    files=$(gh api "repos/$ORG/$repo/pulls/$pr/files" --paginate --jq '.[].filename') || refuse "cannot list files"
    [ -n "$files" ] || refuse "PR has no files"
    bad=$(printf '%s\n' "$files" | grep -v -E '^(\.github/|changelog\.d/|tools/check[_-][^/]+$|tools/tests/)' | head -3)
    [ -z "$bad" ] || refuse "not infra-only; first non-CI paths: $(echo $bad)"
    scope="every changed file is under .github/ or changelog.d/, or is a tools/ checker" ;;
esac

# 3. the fully-clean checker, on this head
args=(--reviewer-out-of-quota agy)
[ -z "$ann" ] || args+=(--annotations-read "$ann")
# Use the checker from ai-config's default branch, not the local checkout (which can be stale and
# lack flags such as --reviewer-out-of-quota).
tmp=$(mktemp -d) || refuse "cannot make a temp directory"
trap 'rm -rf "$tmp"' EXIT
git clone --quiet --depth 1 "https://github.com/$ORG/ai-config.git" "$tmp/ai-config" || refuse "cannot clone ai-config main"
CHECKER="$tmp/ai-config/scripts/check-pr-fully-clean.py"
[ -f "$CHECKER" ] || refuse "no checker in the ai-config clone"
out=$(python3 "$CHECKER" "$pr" -R "$ORG/$repo" "${args[@]}" 2>&1); rc=$?
[ $rc -eq 0 ] || { echo "$out" | grep -E '^  - ' | grep -v NOTE | cut -c1-240 | head -8 >&2; refuse "check-pr-fully-clean.py exited $rc"; }
echo "checker: exit 0 on $head ($scope)"

# 4. head unchanged
now=$(gh pr view "$pr" -R "$ORG/$repo" --json headRefOid -q .headRefOid)
[ "$now" = "$head" ] || refuse "head moved from $head to $now while checking"

if [ $dry -eq 1 ]; then echo "dry run: would merge $ORG/$repo#$pr at $head with a merge commit"; exit 0; fi

# the pinned merge
cd "$AI_CONFIG_CHECKOUT" || refuse "no ai-config checkout"
ALLOW_MERGE=1 gh pr merge "$pr" -R "$ORG/$repo" --merge --match-head-commit "$head" || exit $?
gh pr view "$pr" -R "$ORG/$repo" --json state,mergeCommit -q '"merged: \(.state) \(.mergeCommit.oid)"'
