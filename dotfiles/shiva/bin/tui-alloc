#!/usr/bin/env bash
# Grab an interactive SLURM slice on shiva and launch a TUI coding agent.
#
# Usage: tui-alloc <command> [extra salloc args...]
#   e.g. tui-alloc claude
#        tui-alloc codex --exclude=c1,c2
#
# Resource overrides (env):
#   ALLOC_CPUS       cores      (default 8 hwthreads = 4 physical)
#   ALLOC_MEM        memory     (default 32G -- MUST be set on shiva, see below)
#   ALLOC_TIME       walltime   (default 48:00:00; see the walltime note below)
#   ALLOC_CONDA_ENV  conda env to activate inside the slice (default: none).
#                    e.g. ALLOC_CONDA_ENV=bcs claude-alloc  (for bcs repo work)
#
# shiva notes:
#   - Partition `normal` is OverSubscribe=NO (shared, not exclusive), so a
#     slice leaves the rest of the node free for others.
#   - SelectType=cons_tres/CR_CORE_MEMORY with DefMemPerNode=UNLIMITED: omit
#     --mem and you grab the node's whole 772G, locking everyone out. Always
#     set memory.
#   - c1 is the GPU node; excluded by default for these CPU-only sessions.
#   - Walltime: partition `normal` has MaxTime=UNLIMITED, so the default here
#     is a courtesy limit, not a cluster constraint. It has been raised twice
#     for the same reason, and the failure is worth stating because it is not
#     the one a walltime usually causes: the slice dying takes down everything
#     running INSIDE it, including the agent's background monitors and any
#     watcher polling a long job, so the session loses its observability
#     rather than its work. It was 12h, which expired mid-session during a
#     long working day. 24h then expired at 2026-08-06T11:40:33 on a session
#     that had been running exactly 1-00:00:26 -- a full overnight ARDIA pass
#     with SLURM jobs and PR watchers still in flight. Hence 48h: two working
#     days, so an overnight run plus the following day fits inside one slice.
#     Raise it per invocation with ALLOC_TIME if you need longer.
#     Do not treat a bigger number as free: the slice holds its cores and
#     memory for its whole life even while idle, on a 4-node cluster, so exit
#     the session when you are done rather than letting a long allocation sit.
#     That caution matters more at 48h than it did at 24h, since an abandoned
#     slice now idles for twice as long before SLURM reclaims it.
#   - Long compute belongs in a detached `sbatch` job, not in this slice. A
#     batch job survives the slice expiring; work running inside the slice
#     does not.
set -euo pipefail

CMD="${1:?usage: tui-alloc <command> [salloc args...]}"; shift

# Refuse to nest; lib/slurm-guard.sh records the deadlock this prevents.
# Shared with cnode; resolve through the install symlink to find it.
# shellcheck source-path=SCRIPTDIR
# shellcheck source=../lib/slurm-guard.sh
. "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/slurm-guard.sh"
refuse_if_nested "$CMD"

RCDIR="$HOME/.config/tui-alloc"

export TUI_ALLOC_CMD="$CMD"
export TUI_ALLOC_PWD="$PWD"

# Node-side guard. shiva ships no system zsh on any node -- there is no
# /usr/bin/zsh, on the compute nodes or the login node -- so `zsh -i` resolves
# only because a shared-filesystem zsh sits on PATH
# (`conda install -n base -c conda-forge zsh` -> ~/miniconda3/bin/zsh). Before
# that install the step died with a cryptic
# `env: 'zsh': No such file or directory` (exit 127); if it ever goes missing
# again, drop to an interactive bash with a clear hint instead. Runs inside the
# srun step, so it checks the node, not the login host.
# shellcheck disable=SC2016  # deliberate: this body must reach the node unexpanded
NODE_GUARD='command -v zsh >/dev/null && exec zsh -i
echo "tui-alloc: no zsh on this node ($(hostname)); falling back to bash." >&2
echo "  fix: conda install -n base -c conda-forge zsh  (shared /home makes it visible on all nodes)" >&2
exec bash -i'

exec salloc \
  --job-name="$CMD" \
  --nodes=1 --ntasks=1 \
  --cpus-per-task="${ALLOC_CPUS:-8}" \
  --mem="${ALLOC_MEM:-32G}" \
  --time="${ALLOC_TIME:-48:00:00}" \
  --exclude=c1 \
  "$@" \
  srun --pty env \
    ZDOTDIR="$RCDIR" \
    TUI_ALLOC_CMD="$CMD" \
    TUI_ALLOC_PWD="$PWD" \
    ALLOC_CONDA_ENV="${ALLOC_CONDA_ENV:-}" \
    sh -c "$NODE_GUARD"
