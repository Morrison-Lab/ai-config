#!/usr/bin/env bash
# Interactive zsh on a shiva compute node.
#
# Two things make the obvious commands not work here, both measured on
# 2026-07-31 (Slurm 24.11.3) rather than assumed:
#
#   * `salloc` leaves the shell ON THE HEAD NODE. shiva has
#     `LaunchParameters = (null)`, so salloc's use_interactive_step is off --
#     it prints "Nodes c2 are ready for job" and then runs your shell on
#     shiva anyway. `srun --pty` is what actually moves you.
#   * zsh is NOT installed on the compute nodes (c2/c3/c4 confirmed), so
#     `srun --pty zsh` dies with `execve(): zsh: No such file or directory`.
#     conda's own zsh 5.9 at ~/miniconda3/bin/zsh does run there, and $HOME
#     is shared storage, so it is reachable -- just not on PATH.
#
# Conda is deliberately NOT activated here. `--pty` propagates the current
# environment, so activating on the head node first carries it in; otherwise
# activate inside with the line printed on entry.
set -euo pipefail

CPUS="${CNODE_CPUS:-8}"
MEM="${CNODE_MEM:-32G}"
TIME="${CNODE_TIME:-1-00:00:00}"

ZSH_BIN="${CNODE_ZSH:-$HOME/miniconda3/bin/zsh}"
if [ ! -x "$ZSH_BIN" ]; then
  echo "cnode: no usable zsh at $ZSH_BIN" >&2
  echo "       set CNODE_ZSH, or install one: conda install -n base zsh" >&2
  exit 1
fi

# Refuse to nest. A second srun inside an existing allocation contends with
# that allocation's own step rather than getting a fresh one -- on 2026-07-31
# this deadlocked two jobs, one holding c1 while the other sat in PENDING
# (Resources). Better to say so than to hang.
if command -v sinfo >/dev/null 2>&1; then
  host="$(uname -n)"; host="${host%%.*}"
  if sinfo -h -N -o %N 2>/dev/null | grep -qxF "$host"; then
    echo "cnode: already on compute node $host (job ${SLURM_JOB_ID:-?})." >&2
    echo "       Nesting srun here contends with this allocation. Just run zsh:" >&2
    echo "           exec $ZSH_BIN -i" >&2
    exit 1
  fi
fi

echo "cnode: ${CPUS} cpu, ${MEM}, ${TIME}. Inside, for R 4.6:"
echo "    source ~/miniconda3/etc/profile.d/conda.sh && conda activate bcs"

exec srun --cpus-per-task="$CPUS" --mem="$MEM" --time="$TIME" \
     --job-name=cnode --pty "$ZSH_BIN" -i "$@"
