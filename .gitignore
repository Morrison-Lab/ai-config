.DS_Store
*.swp
*.swo
*~

# Skill-upload build artifacts
skills.zip
skill-zips/

# Python (validators in scripts/)
__pycache__/
*.pyc

# Claude Code worktree-isolated background agents
.claude/worktrees/

# Local git worktrees checked out inside this clone (session-lock / gi).
# Agent Glob/Grep walk these otherwise and can edit a stale copy.
.worktrees/

# Aider local session residue (never commit)
.aider.chat.history.md
.aider.input.history
.aider.tags.cache.v4/

# Quarto website build
_site/
.quarto/

**/*.quarto_ipynb

# Scratch diffs from review tooling (`gh pr diff > N.patch`). Never tracked.
*.patch

# Orchestrator local state databases
*.db
*.db-wal
*.db-shm
.orchestrator/

# Codex project-local config, generated on this machine and never tracked.
# `.codex/agents/*.toml` mirrors `.claude/agents/*.md` one-for-one, and
# `.codex/hooks.json` hardcodes an absolute worktree path, so a committed copy
# would be wrong in every other checkout. Nothing in this repo writes it; the
# Codex tooling does, mid-session, which is how `git add -A` swept it into an
# unrelated commit (ai-config#3683).
.codex/
