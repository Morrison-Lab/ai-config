{
  "enforce-merge-control": {
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/enforce-mwc-review-gate.py"
          },
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      },
      {
        "matcher": "invoke_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      },
      {
        "matcher": "send_message",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      },
      {
        "matcher": "define_subagent",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      },
      {
        "matcher": "call_mcp_tool",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      },
      {
        "matcher": "write_to_file",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      },
      {
        "matcher": "replace_file_content",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      },
      {
        "matcher": "mcp__github__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "python3 ~/.gemini/config/plugins/ai-config/claude-hook-adapter.py"
      }
    ]
  }
}
