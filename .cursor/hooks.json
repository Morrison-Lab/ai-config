{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "command": "python3 .cursor/hooks/adapt-claude-hooks.py --event preToolUse",
        "timeout": 300
      }
    ],
    "postToolUse": [
      {
        "command": "python3 .cursor/hooks/adapt-claude-hooks.py --event postToolUse",
        "timeout": 180
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/adapt-claude-hooks.py --event stop",
        "timeout": 180,
        "loop_limit": 5
      }
    ],
    "sessionStart": [
      {
        "command": "python3 .cursor/hooks/adapt-claude-hooks.py --event sessionStart",
        "timeout": 120
      }
    ]
  }
}
